# 이 파일을 .env 로 복사해서 씁니다. ../setup.sh (또는 setup.ps1) 이 대신 해 줍니다.
# 실제 값은 여기 적지 마세요. 이 파일은 깃에 올라갑니다.

# 개발 중에만 true. 서버에서는 반드시 false.
DEV_MODE=false

# 포털 주소. 같은 도커 네트워크라 컨테이너 이름으로 부릅니다.
PORTAL_API_URL=http://demo-portal:8080
# 포털과 같은 값이어야 등록이 받아들여집니다. setup 이 맞춰 줍니다.
AUDIT_TOKEN=

# 포털 없이 이 앱만 띄워 볼 때만 true.
STANDALONE=false

# ── 점검 ─────────────────────────────────────────────────────
# 규칙 파일. 화면도 사내 명령줄도 이 한 파일을 봅니다.
CHECK_SCRIPT=/app/rules/check-intake.sh

# ★ 체험판에서는 올리기를 받지 않습니다.
#   아무나 zip 을 올려 서버에서 푸는 길을 공개된 곳에 열어 둘 이유가 없습니다.
#   대신 예시 셋을 미리 넣어 두고 고르게 합니다. 검사하는 코드는 같습니다.
#   사내에서는 0 으로 두고 그대로 올려서 씁니다.
DEMO_MODE=1

# 아래는 DEMO_MODE=0 일 때만 씁니다.
MAX_UPLOAD_MB=50
MAX_FILES=5000
MAX_BYTES=314572800
CHECK_TIMEOUT=120

# 장부와 제출물이 남는 곳. 체험판은 컨테이너 안에만 둔다 —
# 다시 띄우면 사라지고 예시 이력이 새로 깔린다.
# 사내에서 쓸 때는 compose 에 ./data 볼륨을 붙이고 이 값을 /data 로 둔다.
INTAKE_DATA_DIR=/app/data

# 체험판에서 이만큼 조용하면 예시 이력을 다시 깐다(분).
# 앞사람이 전부 반려해 둔 화면을 다음 사람이 보면 볼 것이 없다.
DEMO_RESET_MIN=30
