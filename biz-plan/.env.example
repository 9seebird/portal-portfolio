# 이 파일을 .env 로 복사해서 씁니다. ../setup.sh (또는 setup.ps1) 이 대신 해 줍니다.
# 실제 값은 여기 적지 마세요. 이 파일은 깃에 올라갑니다.

# 개발 중에만 true. true 이면 포털 헤더가 없을 때
# 테스트 계정(hong / 홍길동 / 인사총무팀 / admin)으로 동작합니다.
# ★ 서버에서는 반드시 false. setup.sh 가 서버 모드에서 false 로 맞춥니다.
DEV_MODE=false

# 사내 포털 주소. 같은 도커 네트워크라 컨테이너 이름으로 부릅니다.
# 비어 있으면 앱이 자기 등록을 건너뛰어 관리자 화면에 뜨지 않습니다.
PORTAL_API_URL=http://demo-portal:8080

# 포털과 나눠 갖는 서비스 토큰.
# ★ portal/.env 의 AUDIT_TOKEN 과 글자 하나까지 같아야 합니다.
#   setup 스크립트가 맞춰 넣으므로 비워 두세요.
AUDIT_TOKEN=

# ── 이 앱에만 있는 값 ────────────────────────────────────────────
# 파일 하나의 최대 크기(MB). 예시 파일은 둘 합쳐 0.4MB 입니다.
# 앞단 nginx 에서도 한 번 더 막습니다(proxy/apps/biz-plan.conf).
# 여기 값을 올리면 그쪽도 같이 올려야 합니다 — 한쪽만 올리면 413 이 납니다.
BIZPLAN_MAX_MB=30
