# ── AI 공급자 ────────────────────────────────────────────────
# 사내 게이트웨이(비즈라우터 등)를 쓰는 경우 — OpenAI 호환이면 이쪽
PROVIDER=openai
OPENAI_API_KEY=발급받은_게이트웨이_키
OPENAI_BASE_URL=https://<게이트웨이주소>/v1
MODEL=gpt-5-nano

# Anthropic 직접 사용 시
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-opus-5

# gpt-5 계열은 추론 토큰도 이 한도를 함께 쓴다. 작으면 답변이 비어서 온다.
MAX_TOKENS=3000
MAX_TOOL_TURNS=5

# ── 인증 ────────────────────────────────────────────────────
# JWT 서명키 — 임의의 긴 문자열로 반드시 변경. 유출되면 누구나 로그인할 수 있다.
# 생성:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
# 로그인 유지 시간
JWT_EXPIRE_HOURS=12
# 계정 DB
USER_DB=./data/users.db

# ── 기억 ────────────────────────────────────────────────────
MEMORY_DB=./data/memory.db
HISTORY_LIMIT=10
NOTE_LIMIT=20

# ── 기록 보관 ───────────────────────────────────────────────
# 질문·답변 원문을 남길지. 사내 도구에서는 이 기록이 곧 개선 재료다.
# "직원들이 실제로 뭘 어떻게 묻는가"를 봐야 도구 설명을 고칠 수 있다.
# on   : 질문·답변까지 남긴다 (기본). 관리자만 볼 수 있다
# off  : 누가·언제·어떤 기능을 썼는지만 남는다
#        (이미 쌓인 원문은 python manage.py purge-text 로 지운다)
CHAT_LOG_TEXT=on
# 사용 기록 보관 일수. 0 이면 지우지 않는다
CHAT_LOG_DAYS=90
# 대화 내역(본인만 열람) 보관 일수. 0 이면 지우지 않는다
CHAT_KEEP_DAYS=365

# ── 쿠키 (옆 서비스 연동) ───────────────────────────────────
# 로그인하면 portal_token 쿠키가 심어지고, /ai-report/ 같은 옆 서비스가
# 그 쿠키로 "이 사람이 누구인지"를 포털에 물어본다.
# HTTPS 로 전환하면 1 로. http 에서 1 로 두면 쿠키가 저장되지 않는다.
COOKIE_SECURE=0

# 옆 서비스가 /api/audit 으로 이력을 보낼 때 쓰는 공유 토큰.
# 각 서비스의 docker-compose.yml 에 같은 값을 넣는다.
# 비워 두면 /api/audit 이 아예 받지 않는다.
AUDIT_TOKEN=change-this-shared-token

# ── 포털 / ai-report ────────────────────────────────────────
# 서비스·부서 목록 DB
PORTAL_DB=./data/portal.db
PORTAL_BASE_URL=http://10.20.10.10

# ai-report 서비스 주소. 포털은 엑셀을 직접 읽지 않고 이 앱에 물어본다.
# 그래야 대시보드 화면과 챗 답변이 같은 숫자를 말한다.
#   docker : http://demo-aireport:8080   (같은 네트워크의 컨테이너 이름)
#   로컬   : http://localhost:8081
AI_REPORT_API=http://demo-aireport:8080
# 앱이 죽어 있을 때 챗 전체가 멈추지 않도록 짧게 끊는다 (초)
AI_REPORT_TIMEOUT=5
# 직원이 눌러서 들어갈 주소. nginx 경로와 맞춘다.
AI_REPORT_URL=/ai-report/

# ── 사업계획 예상손익 (biz-plan) ────────────────────────────
# 포털은 손익을 계산하지 않는다. 파일 두 개를 앱에 넘기고 요약만 받아 온다.
# 온라인 교육. 이수율·미수강자를 챗에서 물어볼 때 이 주소로 부른다.
EDU_API=http://demo-edu:8080
EDU_URL=/edu/
EDU_TIMEOUT=5

BIZPLAN_API=http://demo-biz-plan:8080
# 직원이 눌러서 들어갈 주소. nginx 경로와 맞춘다.
BIZPLAN_URL=/biz-plan/
# 계산 0.4초 · 엑셀 3개 1.4초. 파일이 오가는 시간까지 여유를 둔다 (초).
BIZPLAN_TIMEOUT=120

# ── 챗 파일 첨부 ────────────────────────────────────────────
# 직원이 챗 입력창에 이력서 같은 파일을 붙일 수 있다.
# 포털은 파일을 열어보지 않는다. 받아서 보관하고, 분석은 그 일을 하는 앱이 한다.
UPLOAD_DIR=./data/uploads
# ★ 이 값을 올리면 nginx 쪽도 같이 올라가 있어야 한다.
#   proxy/conf.d/portal.conf 와 portal/deploy/host-nginx/portal-chat.conf
#   의 client_max_body_size (지금 150m). 둘 중 하나만 올리면 413 이 난다.
UPLOAD_MAX_MB=120
UPLOAD_EXTS=pdf,docx,doc,hwp,hwpx,xlsx,xls,csv,txt,md,json,pptx,ppt,html,htm,png,jpg,jpeg,webp
# 포털에 남는 사본의 보관 기간. 앱 쪽 사본은 그 앱이 따로 관리한다.
UPLOAD_KEEP_DAYS=30
# 남이 올린 파일까지 볼 수 있는 계정 (쉼표로 여러 명).
# ★ is_admin 과 별개다. 관리자를 늘려도 여기 없으면 못 본다.
UPLOAD_VIEWERS=admin

# ── 첨부 파일 읽기 (전용 앱이 없을 때) ──────────────────────
# 붙인 문서에서 글자를 뽑아 모델에게 넘긴다. "이거 요약해줘" 가 된다.
# ★ 문서 내용이 AI 공급자로 나간다. 지금까지 포털이 하던 일(앱에 물어보고
#   답만 옮기기)과 성격이 다르다. 민감한 문서는 전용 앱을 쓰는 편이 맞다.
FILE_READ=on
# 모델에게 넘길 최대 글자 수. 길수록 비용이 그대로 늘어난다.
FILE_TEXT_MAX_CHARS=20000

# ── 그림 읽기 (사진·화면 캡처·스캔한 PDF) ───────────────────
# OCR 엔진을 설치하지 않는다. 게이트웨이에 그림을 그대로 넘겨서 읽는다.
# 쓸 수 있는지는 check_vision.py 로 확인한 뒤 켠다.
# ★ 사진이 통째로 AI 공급자로 나간다. 명함·신분증·화이트보드 사진이
#   그대로 넘어간다는 뜻이다. 곤란하면 off 로 두면 예전처럼 거절한다.
VISION=on
# 읽기만 하므로 챗 모델과 같을 필요가 없다. 비우면 MODEL 을 쓴다.
# 확인 결과(2026-08): gpt-5-mini 4.4초 / gemini-3.5-flash-lite 1.4초, 둘 다 정확
VISION_MODEL=google/gemini-3.5-flash-lite
# 이 크기를 넘는 그림은 줄여서 올려 달라고 말한다. 토큰이 그만큼 든다.
VISION_MAX_MB=8
# 스캔한 PDF 를 최대 몇 쪽까지 볼지. 쪽수만큼 비용이 는다.
VISION_MAX_PAGES=5
VISION_TIMEOUT=120

# ── 대화 제목 ───────────────────────────────────────────────
# 목록에 「새 대화」 대신 "AI 사용량 문의 · 6월" 같은 제목을 붙인다.
# 모델을 한 번 더 부르는 일이라, 한 대화에 세 번만 짓는다 (1·3·7번째 질문).
CHAT_TITLES=on
# 제목 지을 때 쓸 모델. 비우면 위의 MODEL 을 쓴다.
# ★ **추론하지 않는 모델**을 넣는 편이 낫다. 한 줄 받아오는 일에
#   생각할 필요가 없고, 싸고 빠르다.
# TITLE_MODEL=google/gemini-3.5-flash-lite
# ★ gpt-5 계열을 쓸 거라면 이 값을 넉넉히 둔다. 그 모델들은 **생각하는 데도**
#   이 한도를 쓴다. 600 으로 뒀더니 생각만 하다 끝나서(finish_reason=length)
#   제목이 늘 빈 채로 왔고, 화면에는 아무 오류 없이 「새 대화」만 남았다.
TITLE_MAX_TOKENS=2000

# ── AI 사용량·비용 ──────────────────────────────────────────
# 챗·제목·그림 읽기가 공급자에 얼마나 쓰는지 관리자 화면(AI 사용량)에 모인다.
# 토큰 수는 설정 없이도 보인다. **금액까지 보려면 단가를 적어야 한다.**
# 계약마다 단가가 다르므로 포털이 임의로 정하지 않는다.
#
#   모델:입력단가,출력단가  —  100만 토큰당 원(₩). 여러 개는 ; 로 잇는다.
#   비즈라우터 요금표를 보고 채워 넣으면 된다. (아래 숫자는 예시다)
# USAGE_PRICES=openai/gpt-5-mini:350,2800;google/gemini-3.5-flash-lite:140,560
USAGE_KEEP_DAYS=180

# ── IT 안내 (매뉴얼 · 운영 체크리스트) ──────────────────────
# 옛 포털에 있던 정적 화면을 옮겨 온 것. 백엔드가 없어서 포털이
# HTTP 로 파일을 가져와 읽는다 (app/tools/guide.py).
#   docker : http://demo-guide-web:80
#   로컬   : http://localhost:8302
GUIDE_API=http://demo-guide-web:80
# 직원이 눌러서 들어갈 주소. 프록시 경로(proxy/apps/*.conf)와 맞춘다.
MANUAL_URL=/manual/
CHECKLIST_URL=/checklist/
GUIDE_TIMEOUT=5
# 매뉴얼은 한 달에 몇 번 바뀔까 말까다. 그동안 담아 둔다 (초).
GUIDE_CACHE_SEC=300

# ── 공개 체험판 (사내에서는 0) ──────────────────────────────
# 1 로 두면 app/demo.py 가 켜진다. 세 가지를 한다.
#   · 남는 것을 바꾸는 주소를 막는다 (/api/admin/* · /api/me/password)
#   · 챗을 IP당 하루 몇 번 · 전체 월 몇 토큰으로 묶는다
#   · 체험 계정을 만들고, 뜰 때마다 비밀번호를 원래대로 되돌린다
# 0 이면 이 파일의 어떤 값도 읽히지 않는다.
DEMO_MODE=0
DEMO_USER_ID=demo
DEMO_PASSWORD=demo1234
# 한 사람이 눌러 볼 만큼. 도구도 몇 개 써 보게 넉넉히.
DEMO_CHAT_PER_IP_DAY=20
# ★ 이쪽이 진짜 방어선이다. IP 는 바꾸면 그만이라 위쪽만으로는 안 막힌다.
#   이 한도를 넘으면 챗만 쉬고 나머지 앱은 그대로 열려 있는다.
DEMO_TOKENS_PER_MONTH=3000000

# 하루치 전체 토큰. ★ 달 한도만 두면 한 사람이 IP 를 바꿔 가며 하루 만에
#   다 태울 수 있고, 그러면 남은 한 달 내내 챗이 죽어 있는다.
#   하루 한도가 있으면 최악의 날도 **다음 날 아침에 되살아난다.**
#   비워 두면 달 한도의 1/20 (= 20일치)로 잡는다.
DEMO_TOKENS_PER_DAY=150000
DEMO_DB=./data/demo.db
