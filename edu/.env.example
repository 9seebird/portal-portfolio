# 이 파일을 .env 로 복사해서 씁니다. ../setup.sh (또는 setup.ps1) 이 대신 해 줍니다.
# 실제 값은 여기 적지 마세요. 이 파일은 깃에 올라갑니다.

# ── 로그인 방식 ─────────────────────────────────────────────
# portal     : 앞단의 챗 포털이 로그인·권한을 맡습니다. 이 앱은 포털이 붙여 준
#              X-User-* 헤더만 읽습니다. 포털에 붙여 쓸 때는 이쪽입니다.
# standalone : 포털 없이 이 앱 혼자 돌 때. 아이디 + 비밀번호를 직접 받습니다.
AUTH_MODE=portal

# 챗 포털 주소. 같은 도커 네트워크라 컨테이너 이름으로 부릅니다.
PORTAL_API_URL=http://demo-portal:8080

# 포털과 나눠 갖는 서비스 토큰.
# ★ portal/.env 의 AUDIT_TOKEN 과 글자 하나까지 같아야 합니다.
#   setup 스크립트가 맞춰 넣으므로 비워 두세요.
AUDIT_TOKEN=

# ── 단독 모드에서만 쓰이는 값 ───────────────────────────────
# 맨 처음 교육 담당자의 아이디. 명단이 아직 없을 때 이 아이디로 들어와 명단을 올립니다.
ADMIN_IDS=

# 계정을 새로 만들 때 넣어 주는 초기 비밀번호.
DEFAULT_PASSWORD=edu1234

# 새 비밀번호 최소 길이. 1 이면 사실상 제한 없음.
PASSWORD_MIN_LEN=1

# 로그인 상태 유지 시간(시간)
SESSION_HOURS=72

# 로그인 쿠키 서명용 열쇠. 비우면 처음 뜰 때 만들어 data/secret.key 에 넣습니다.
SECRET_KEY=

# HTTPS 로 서비스할 때만 1
COOKIE_SECURE=0

# ── 그 밖에 ─────────────────────────────────────────────────
# 개발용. true 면 로그인 없이 테스트 계정으로 동작합니다. ★ 배포에서는 false.
DEV_MODE=false

# 업로드 PDF 최대 크기(MB)
MAX_UPLOAD_MB=30
