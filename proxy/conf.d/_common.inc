# 두 server 블록(80 · 8082)이 함께 쓰는 지시어.
# .inc 라서 nginx 가 스스로 읽지 않는다 — 부르는 쪽에서 include 한다.
#
# listen 과 server_name 은 여기 두지 않는다. 두 입구가 다른 값을 쓰는
# 유일한 항목이라, 부르는 쪽 server 블록에 그대로 적어 두는 편이 읽기 쉽다.

    # 업로드 파일 크기. 각 앱의 MAX_UPLOAD_MB 보다 넉넉하게.
    #
    # 20m 이던 것을 150m 로 올렸다. 큰 엑셀 때문이다 —
    # 6월 마감본이 63MB 라, 챗에 붙이면 20m 에서 413 으로 튕겼다.
    # 앱마다 더 필요하면 그 앱의 conf 에서 다시 키운다
    # (앱에 따라 300m 까지 둔다). 여기 값은 그보다 작아도 되지만,
    # **챗에 붙이는 파일은 여기를 지나므로** 챗에서 다룰 가장 큰 파일보다 커야 한다.
    client_max_body_size 150m;

    # 리다이렉트를 "/login" 처럼 상대 주소로 내보낸다.
    #
    # 기본값(on)이면 nginx 가 스스로 절대 주소를 만들어 붙인다.
    #   Location: http://portal.mir.example.com/login
    # 앞에 호스트 nginx 가 있고 브라우저가 https 로 들어온 경우,
    # 이 http 주소로 한 번 튕겼다가 다시 https 로 돌아오게 된다.
    # 컨테이너를 8081 같은 포트로 띄우면 그 포트까지 붙어서
    #   Location: http://...:8081/login   ← 브라우저가 못 가는 주소
    # 가 나간다. 상대 주소로 두면 브라우저가 현재 주소·스킴을 그대로 쓴다.
    absolute_redirect off;
