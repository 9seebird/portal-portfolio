#!/usr/bin/env bash
# =====================================================================
# push 하기 직전에 사내 정보가 섞였는지 본다. 걸리면 **push 자체를 취소한다.**
#
# ── 왜 깃허브가 아니라 여기서 막나 ──────────────────────────
# 실명 목록(.secretwords)에는 실제 직원 이름이 들어 있다. 그걸 깃허브
# Secrets 에 올리면 CI 가 검사해 주지만, 목록이 있는 곳이 한 군데 늘어난다.
#
# 여기서 막으면 **깃허브에 아무것도 도달하지 않는다.** 한 번 올라간 것은
# 히스토리에 남아서 지우기 번거롭다 — 실제로 그 일을 겪었다.
# 그래서 목록은 내 PC 밖으로 내보내지 않고, 검사만 push 앞에 세웠다.
#
# ── 설치 ────────────────────────────────────────────────────
# .git/hooks 는 깃에 올라가지 않아서 PC 마다 따로 만들어야 한다.
# 그래서 이 폴더(.githooks)를 저장소에 두고, setup 이 이렇게 가리키게 한다.
#
#   git config core.hooksPath .githooks
#
# 새 PC 에서 ./setup.sh (또는 .\setup.ps1) 한 번이면 끝난다.
#
# ── 급할 때 ─────────────────────────────────────────────────
#   git push --no-verify      이 검사를 건너뛴다
# 쓰지 않는 편이 좋다. 정말 오탐일 때만.
# =====================================================================
ROOT="$(git rev-parse --show-toplevel)"

printf '\n▸ push 전 검사 — 사내 정보가 섞였나\n'

# --strict : 낱말 목록이 없으면 「건너뜀」이 아니라 「실패」다.
#   PC 두 대를 오가면 한쪽에만 목록이 있기 쉽고, 조용히 건너뛰면
#   그날 그 PC 에서 push 한 것만 검사를 안 받은 채로 나간다.
if bash "$ROOT/tools/check_secrets.sh" --strict; then
  exit 0
fi

cat <<'MSG'

  ✗ push 를 취소했습니다.

    고친 뒤 다시 push 하세요.
    정말 오탐이면  git push --no-verify  로 넘길 수 있습니다.

MSG
exit 1
