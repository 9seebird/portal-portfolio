# 서버 배포용 환경 파일. 이 파일을 .env.deploy 로 복사해 값을 채운다.
# .env.deploy 는 절대 git 에 올리지 않는다 (.gitignore 확인).

PRODUCTION=true

# 아래 명령으로 생성한 값을 붙여넣는다:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=여기에-생성한-값

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 같은 주소(/api)로 서빙되므로 사실상 안 쓰이지만, 명시해 둔다.
CORS_ORIGINS=http://서버IP:8081
