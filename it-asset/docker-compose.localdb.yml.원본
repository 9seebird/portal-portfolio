# 로컬 개발용 PostgreSQL.
#
# 운영 서버(Azure B2ts v2 / RAM 1GiB)에서는 이 파일을 쓰지 않는다.
# 그 서버에서는 DATABASE_URL 을 SQLite 로 두는 편이 메모리상 안전하다.
#   DATABASE_URL=sqlite+pysqlite:///./data/app.db
# 근거는 docs/ARCHITECTURE.md 참고.
#
# (version: 태그는 최신 Compose 에서 무시되고 경고만 내므로 제거했다)

services:
  db:
    image: postgres:17-alpine
    container_name: it-asset-db
    restart: unless-stopped

    environment:
      POSTGRES_DB: ${POSTGRES_DB:-asset_portal}
      POSTGRES_USER: ${POSTGRES_USER:-asset_user}
      # 비밀번호를 파일에 박아두지 않는다. .env 에서 읽고, 없으면 아예 뜨지 않는다.
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD 를 .env 에 설정하세요}

    # 외부에 5432 를 열지 않는다. 호스트 로컬에서만 접속 가능.
    ports:
      - "127.0.0.1:5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-asset_user}"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
