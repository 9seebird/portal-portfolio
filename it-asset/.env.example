# 개발 중에만 true. true 이면 포털 헤더가 없을 때
# 테스트 계정(hong / 홍길동 / 인사총무팀 / admin)으로 동작합니다.
# ★ 서버에서는 반드시 false.
DEV_MODE=false

# 사내 포털 주소. 같은 도커 네트워크라 컨테이너 이름으로 부릅니다.
# ★ 이 줄이 없으면 앱이 뜰 때 **자기 등록을 건너뜁니다.**
#   관리자 화면에 이미 보이더라도 그건 전에 등록해 둔 기록일 뿐이라,
#   이름·설명·키워드가 영영 갱신되지 않습니다.
PORTAL_API_URL=http://demo-portal:8080

# 포털이 서버 대 서버로 이 앱을 부를 때 쓰는 공유 토큰.
# ★ portal/.env 의 AUDIT_TOKEN 과 **글자 하나까지 같아야 한다.**
#   다르면 포털이 이 앱을 못 부르고 "Unauthorized" 만 돌아온다.
#   ../setup.sh (또는 setup.ps1) 이 세 파일에 같은 값을 맞춰 넣어 준다.
AUDIT_TOKEN=
